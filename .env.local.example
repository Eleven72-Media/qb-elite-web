# Copy to .env.local and fill in.

# Supabase — pull from qb_elite_source/.env (same project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL — used for OAuth + email-verify callback redirects
# Local: http://localhost:3000
# Vercel preview: leave empty, defaults to window.location.origin
# Production: https://app.quarterbackelite.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — added in Sprint 4
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_STRIPE_PRICE_STARTER_MONTHLY=
# NEXT_PUBLIC_STRIPE_PRICE_STARTER_YEARLY=
# NEXT_PUBLIC_STRIPE_PRICE_LEGEND_MONTHLY=
# NEXT_PUBLIC_STRIPE_PRICE_LEGEND_YEARLY=

# Subscription pivot 2026-07 — set to "true" to block new sign-ups.
# Both the /paywall page and the /api/stripe/checkout API check this flag.
# Remove the var (or set to anything other than "true") to re-enable sign-ups.
# NEXT_PUBLIC_SUBSCRIPTIONS_PAUSED=true
